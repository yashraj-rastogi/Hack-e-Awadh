# Firebase Web Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Gemini API Key
VITE_GEMINI_API_KEY=

# Payment Mode
VITE_ENABLE_MOCK_PAYMENT=
VITE_PAYTM_MID=
VITE_PAYTM_MERCHANT_KEY=

# Twilio WhatsApp (Optional / P1)
VITE_TWILIO_ACCOUNT_SID=
VITE_TWILIO_AUTH_TOKEN=
VITE_TWILIO_WHATSAPP_NUMBER=

# ElevenLabs (server-side only, proxied by Vite dev/preview server; never exposed to the browser)
ELEVENLABS_API_KEY=
# Optional. Blank uses Daniel, a premade male voice (onwK4e9ZLuTAKqWW03F9), with eleven_multilingual_v2.
# A paid plan can set a Hindi library voice here; free plans fall back to Daniel if synthesis is rejected.
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=
